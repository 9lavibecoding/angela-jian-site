---
import Base from '../../layouts/Base.astro';
import { getArticles, getArticleBySlug } from '../../lib/notion';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map(a => ({
    params: { slug: a.slug },
  }));
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) {
  return Astro.redirect('/404');
}

// Related articles: same tag first, then recent, exclude current
const allArticles = await getArticles();
const currentTags = new Set(article.tags);
const others = allArticles.filter(a => a.slug !== slug);
const related = others
  .map(a => ({
    ...a,
    relevance: a.tags.filter(t => currentTags.has(t)).length,
  }))
  .sort((a, b) => b.relevance - a.relevance || b.date.localeCompare(a.date))
  .slice(0, 3);
---

<Base title={`${article.title} — AI PM INSIDER`} description={article.summary} ogImage={article.image}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": article.title,
    "description": article.summary,
    "datePublished": article.date?.replaceAll('.', '-'),
    "dateModified": article.date?.replaceAll('.', '-'),
    "author": { "@type": "Person", "name": "Angela Jian 簡琬庭", "url": Astro.site?.toString() },
    "publisher": { "@type": "Person", "name": "Angela Jian 簡琬庭" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": new URL(Astro.url.pathname, Astro.site).toString() },
    ...(article.image ? { "image": article.image } : {}),
  })} />

  <!-- Article Header -->
  <section class="relative pt-28 md:pt-32 overflow-hidden bg-white">
    <div class="site-container px-6 md:px-12 relative z-10">
      <div class="max-w-3xl mx-auto">

        <!-- Back Link -->
        <a href="/#articles" class="inline-flex items-center gap-2 text-brand-light-subtle text-sm font-body mb-8 md:mb-10 hover:text-brand-accent-dark transition-colors">
          <iconify-icon icon="solar:arrow-left-linear" class="text-lg"></iconify-icon>
          <span>返回首頁</span>
        </a>

        <!-- Tags + Date -->
        <div class="flex items-center gap-2 md:gap-3 mb-4 md:mb-6 flex-wrap">
          {article.tags.map(tag => (
            <span class="px-3 py-1.5 text-xs bg-brand-accent-dark/10 text-brand-accent-dark rounded-full font-body">{tag}</span>
          ))}
          <span class="text-sm text-brand-light-subtle font-body">{article.date}</span>
        </div>

        <!-- Title -->
        <h1 class="font-heading font-bold text-2xl md:text-5xl lg:text-6xl leading-tight mb-6 md:mb-8 text-brand-light-text">
          {article.title}
        </h1>

        <!-- Author -->
        <div class="flex items-center gap-4 mb-4 md:mb-6 pb-4 md:pb-6 border-b border-brand-light-border">
          <div class="w-12 h-12 rounded-full overflow-hidden border border-brand-accent-dark/30">
            <img src="/angela-photo.jpg"
                 alt="Angela Jian" class="w-full h-full object-cover">
          </div>
          <div>
            <div class="font-heading font-semibold text-sm text-brand-light-text">Angela</div>
            <div class="text-xs text-brand-light-subtle font-body">Sr. Product Manager / AI Product Builder</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="relative pb-20 md:pb-32 overflow-hidden bg-white">
    <div class="site-container px-6 md:px-12 relative z-10">
      <div class="max-w-3xl mx-auto article-content-light text-base">
        {article.content ? (
          <div set:html={article.content} />
        ) : (
          <div class="text-center py-16 md:py-20">
            <iconify-icon icon="solar:document-text-bold" class="text-brand-accent-dark text-5xl mb-4"></iconify-icon>
            <p class="text-brand-light-subtle font-body text-lg mb-6">本文內容即將上線</p>
            <p class="text-brand-light-subtle font-body text-sm mb-8">完整文章內容正在準備中，敬請期待。</p>
            {article.url && (
              <a href={article.url} target="_blank" rel="noopener noreferrer"
                 class="mag-btn px-6 md:px-8 py-3 md:py-4 gold-gradient text-white font-heading font-semibold rounded-full text-sm tracking-wide inline-flex items-center gap-2">
                <span>前往 LinkedIn 閱讀原文</span>
                <iconify-icon icon="solar:arrow-right-up-linear" class="text-lg"></iconify-icon>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Related Articles -->
      {related.length > 0 && (
        <div class="max-w-3xl mx-auto mt-12 md:mt-16 pt-8 md:pt-12 border-t border-brand-light-border">
          <h2 class="font-heading font-bold text-xl md:text-2xl text-brand-light-text mb-6">延伸閱讀</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {related.map(r => (
              <a href={`/articles/${r.slug}`}
                 class="block p-4 rounded-xl border border-brand-light-border hover:border-brand-accent-dark/30 hover:shadow-sm transition-all no-underline group">
                <div class="flex items-center gap-2 mb-2">
                  {r.tags.slice(0, 1).map(tag => (
                    <span class="px-2 py-0.5 text-[10px] rounded-full bg-brand-accent-dark/10 text-brand-accent-dark font-body">{tag}</span>
                  ))}
                </div>
                <h3 class="font-heading font-semibold text-sm leading-snug text-brand-light-text group-hover:text-brand-accent-dark transition-colors line-clamp-2">{r.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back to Articles -->
      <div class="max-w-3xl mx-auto mt-8 md:mt-10 pt-8 md:pt-10 border-t border-brand-light-border">
        <a href="/#articles" class="mag-btn px-6 md:px-8 py-3 md:py-4 border border-brand-light-border text-brand-light-text font-heading font-medium rounded-full text-sm tracking-wide hover:border-brand-accent-dark hover:text-brand-accent-dark transition-colors">
          <span>← 返回所有文章</span>
        </a>
      </div>
    </div>
  </section>

<script is:inline>
  document.querySelectorAll('.article-content-light img').forEach(img => {
    img.addEventListener('error', () => { img.style.display = 'none'; });
  });

  // Style Newsletter CTA paragraph + hashtag paragraph (markdown-only, no Notion change)
  document.querySelectorAll('.article-content-light p').forEach((p) => {
    const text = p.textContent || '';
    if (text.includes('歡迎追蹤這份 Newsletter') || text.includes('追蹤這份 Newsletter')) {
      p.classList.add('article-cta');
    }
    if (/^\s*#[\w一-龥]/.test(text)) {
      p.classList.add('article-hashtags');
    }
  });
</script>

<style is:global>
  .article-content-light .article-cta {
    margin: 3rem 0 1rem !important;
    padding: 1.75rem 1.75rem 1.75rem 4rem !important;
    background: linear-gradient(135deg, #FAF6EF, #F3EDE4) !important;
    border: 1px solid #E0D5C5 !important;
    border-left: 4px solid #C5A55A !important;
    border-radius: 0.75rem !important;
    color: #1a1814 !important;
    font-size: 0.95rem !important;
    line-height: 1.75 !important;
    position: relative;
  }
  .article-content-light .article-cta::before {
    content: "✉";
    position: absolute;
    left: 1.5rem;
    top: 1.6rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: #C5A55A;
    color: #fff;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .article-content-light .article-hashtags {
    margin-top: 1.5rem !important;
    font-size: 0.75rem !important;
    color: #78716C !important;
    letter-spacing: 0.02em;
    word-break: keep-all;
  }
</style>

</Base>
